---
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 28rem),
      radial-gradient(circle at 0% 40%, color-mix(in srgb, #f59e0b 8%, transparent), transparent 24rem);
  }

  form {
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--border));
    border-radius: calc(var(--radius) + 0.35rem);
    background: color-mix(in srgb, currentColor 4%, transparent);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, #000 8%, transparent);
  }

  .field input {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
  }

  .field input::placeholder {
    color: var(--muted);
  }

  .bookmark {
    background: color-mix(in srgb, currentColor 3%, transparent);
    transition: transform 160ms ease, border-color 160ms ease;
  }

  .bookmark:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
  }

  .bookmark .url {
    color: inherit;
    text-decoration: none;
  }

  .bookmark .url:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.2em;
  }

  .bookmark .slug {
    font-family: var(--font-body);
  }
</style>

<script>
  import {
    createSlug,
    formatBookmark,
    loadBookmarks,
    normalizeUrl,
  } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  let bookmarks = [];

  function readBookmarks() {
    try {
      return loadBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      return [];
    }
  }

  function saveBookmarks() {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(bookmarks));
    } catch {
      // Storage can be unavailable or full; the in-memory list remains usable.
    }
  }

  function render() {
    if (!list || !emptyState || !listHeader) return;

    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';
      item.setAttribute('aria-label', formatBookmark(bookmark));

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noreferrer noopener';
      link.textContent = bookmark.url;

      const separator = document.createTextNode(' :: ');
      const slug = document.createElement('code');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy slug';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copy.textContent = 'Copied';
          window.setTimeout(() => { copy.textContent = 'Copy slug'; }, 1200);
        } catch {
          copy.textContent = 'Copy failed';
          window.setTimeout(() => { copy.textContent = 'Copy slug'; }, 1200);
        }
      });

      item.append(link, separator, slug, copy);
      list.append(item);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const url = normalizeUrl(input?.value ?? '');
    if (!url) {
      input?.focus();
      return;
    }

    bookmarks = [...bookmarks, {
      url,
      slug: createSlug(bookmarks.map((bookmark) => bookmark.slug)),
    }];
    saveBookmarks();
    render();
    form.reset();
    input?.focus();
  });

  clearAll?.addEventListener('click', () => {
    if (!bookmarks.length || !window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    saveBookmarks();
    render();
  });

  bookmarks = readBookmarks();
  render();
</script>
